generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED") // Neon recommends using the pooled connection string
  directUrl = env("DATABASE_URL")        // Needed for migrations
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPERADMIN
  ADMIN
}

model SuperAdminOtp {
  id        String   @id @default(cuid())
  email     String
  targetId  String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, targetId])
}

model Feedback {
  id        String   @id @default(cuid())
  name      String?
  email     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum SpotlightType {
  volunteer
  lecturer
}

model Spotlight {
  id                 String        @id @default(cuid())
  type               SpotlightType
  monthYear          String        // e.g., "October 2026"
  name               String
  departmentOrRole   String
  story              String        @db.Text
  imageUrl           String
  isPublished        Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model GlobalSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AssociationLeader {
  slug      String   @id
  name      String
  title     String
  session   String
  updatedAt DateTime @updatedAt
}

model Event {
  id            String              @id @default(cuid())
  slug          String              @unique
  title         String
  frequency     String              @default("Annual Event")
  date          DateTime
  time          String?
  venue         String
  description   String              @db.Text
  coverImageUrl String              @map("cover_image_url")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  galleryImages EventGalleryImage[]

  @@map("events")
}

model EventGalleryImage {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_gallery_images")
}

model News {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  date        String
  body        String   @db.Text
  imageUrl    String   @default("/news/default.png")
  imageAlt    String?
  category    String   @default("Digest")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
  @@index([category])
  @@map("news")
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  release     String   @default("Release #01")
  category    String   @default("Campus Life")
  author      String   @default("ULES Editorial")
  authorBio   String   @default("The official voice and stories from the University of Lagos Engineering Society.") @db.Text
  authorPfp   String?  @default("/logo/logo-transparent.png")
  date        String
  description String   @db.Text
  body        String   @db.Text
  imageUrl    String   @default("/blogs/my-first-love-letter.jpeg")
  imageAlt    String?
  readTime    String   @default("3 min read")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
  @@index([category])
  @@map("blog_posts")
}

model ExecutiveLeader {
  id          String   @id @default(cuid())
  name        String
  title       String   // Post held / Position (e.g. President, Social Secretary)
  department  String
  phoneNumber String
  email       String
  imageUrl    String   @default("/logo/logo-transparent.png")
  order       Int      @default(0)
  session     String   @default("2025/2026")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([isPublished, order])
  @@map("executive_leaders")
}

